{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "WhatsApp Bot with AI Integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=512 dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:clean": "./scripts/start-dev.sh",
    "dev:preserve": "ts-node src/index.ts",
    "restart": "./scripts/restart.sh",
    "watch": "tsc --watch",
    "generate-token": "node scripts/generate-token.js",
    "reset-outgoing-consumer": "node scripts/reset-outgoing-consumer-group.js",
    "reset-weaviate-consumer-position": "node scripts/reset-weaviate-consumer-position.js",
    "waofficial-dev": "node services/whatsapp-official/index.js",
    "pubsub-dev": "node services/pubsub/index.js",
    "socket-server-dev": "./scripts/start-socket-server.sh",
    "test-socket": "node scripts/test-socket-client.js"
  },
  "dependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@wppconnect-team/wppconnect": "^1.37.9",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "cron-parser": "^5.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "extract-zip": "^2.0.1",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lokijs": "^1.5.12",
    "mongoose": "^8.18.1",
    "node-cron": "^4.2.1",
    "node-vault": "^0.10.9",
    "phoenix": "^1.8.3",
    "puppeteer": "^24.34.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "redis": "^4.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "weaviate-ts-client": "^1.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lokijs": "^1.5.7",
    "@types/node": "^20.8.0",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
